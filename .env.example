# Firebase Web config — Firebase Console → Project settings → General → Your apps → Web app.
# Скопируйте этот файл в .env.local и заполните значения. .env.local не коммитится.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Только для разработки: подключиться к локальным эмуляторам (npm run emulators, нужна Java).
# VITE_FIREBASE_EMULATORS=true
